# --- Database ---
DB_NAME=msme_marketplace
DB_USER=msme_dev
DB_PASSWORD=devpassword
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://msme_dev:devpassword@localhost:5432/msme_marketplace

# --- Django (backend-django) ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
MEDIA_ROOT=./media
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Postgres TLS: "require" on Azure Flexible Server.
DB_SSLMODE=prefer
# Web refresh-token cookie. Secure defaults to (not DEBUG); SameSite=None is only
# needed when the web app and API are on different sites (e.g. *.azurecontainerapps.io).
# REFRESH_COOKIE_SECURE=True
REFRESH_COOKIE_SAMESITE=Lax
# Production (DJANGO_DEBUG=False) only: origins allowed to POST forms (admin).
CSRF_TRUSTED_ORIGINS=
# Azure Blob Storage for uploads; empty = local MEDIA_ROOT.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media
# Error tracking (both backends); empty = off.
SENTRY_DSN=

# --- FastAPI (backend-fastapi) ---
FASTAPI_ENV=development
DJANGO_API_BASE_URL=http://localhost:8000
# data.gov.in API key for Agmarknet mandi-price ingestion (scheduler/agmarknet.py).
# Free key: register at https://data.gov.in, then My Account -> API key.
# Empty = data.gov.in's public sample key (10 records per call, fine for a demo)
# unless AGMARKNET_USE_SAMPLE_KEY=false.
AGMARKNET_API_KEY=
AGMARKNET_USE_SAMPLE_KEY=true
# Extra commodities to always ingest, comma-separated (listed/required ones are automatic).
AGMARKNET_COMMODITIES=
# Django's media directory as seen by FastAPI (grading reads evidence from it).
# Empty = ../backend-django/media (local dev layout).
DJANGO_MEDIA_ROOT=
# Trained grading checkpoints (<dir>/<vertical>/grader.pt). Empty = ml-training/checkpoints.
GRADING_MODELS_DIR=
# When evidence isn't on a shared disk (Azure): blob container URL + read-only SAS query.
EVIDENCE_BASE_URL=
EVIDENCE_URL_QUERY=

# Path to a Firebase service-account JSON; leave empty to disable FCM push.
FIREBASE_CREDENTIALS_FILE=

# --- Django -> FastAPI (both) ---
FASTAPI_BASE_URL=http://localhost:8001
# Shared secret for the Django-only compute routes (grading, matching). Set it in
# both services whenever FastAPI is reachable from outside; empty = not enforced.
COMPUTE_INTERNAL_TOKEN=

# --- Frontend (web-app) ---
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000/api
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8001/compute
